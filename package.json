{
  "name": "inkflow",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "bindings": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin export-bindings",
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "vitest run",
    "test:brand": "node scripts/brand-assets.mjs",
    "test:nsis-path": "node scripts/nsis-path-contract.mjs",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "icons:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-windows-icons.ps1",
    "icons:windows:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-windows-icons.ps1 -Check",
    "cli:test": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --features cli --lib --test cli_contract -- --test-threads=1",
    "cli:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-cli-sidecar.ps1",
    "cli:schema": "node scripts/cli-schema.mjs write",
    "cli:schema:check": "node scripts/cli-schema.mjs check",
    "tauri:build": "pnpm cli:build && tauri build --config src-tauri/tauri.bundle.conf.json --bundles nsis",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "perf:fixture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-perf-fixture.ps1",
    "perf:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/perf-windows.ps1",
    "perf:cli": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/perf-cli-windows.ps1",
    "release:validate": "node scripts/release-metadata.mjs validate",
    "release:finalize": "node scripts/release-metadata.mjs finalize",
    "verify": "pnpm bindings && pnpm check && pnpm test && pnpm test:brand && pnpm icons:windows:check && pnpm test:nsis-path && pnpm format:rust:check && cargo test --manifest-path src-tauri/Cargo.toml -- --test-threads=1 && pnpm cli:test && pnpm cli:schema:check && pnpm cli:build && pnpm build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lucide/svelte": "^1.47.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "css-tree": "3.2.1",
    "decode-named-character-reference": "1.3.0",
    "entities": "8.1.0",
    "hast-util-from-html-isomorphic": "2.0.0",
    "js-yaml": "5.4.2",
    "katex": "^0.18.7",
    "mermaid": "^11.17.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.57.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/css-tree": "^3.2.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
